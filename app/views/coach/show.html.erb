<%# Shown inside the coach panel (turbo frame "coach"). Links in answers open in the full page. %>
<%= turbo_frame_tag "coach", target: "_top", class: "coach-frame" do %>
  <% questions_left = @chat ? @chat.questions_left : Chat::MAX_COACH_QUESTIONS %>

  <div class="coach-messages" data-controller="coach" data-coach-target="messages">
    <% if @messages.empty? %>
      <div class="coach-intro">
        <p class="mb-2"><strong>Hi! 👋 I'm your coach.</strong></p>
        <p class="mb-3">
          <% if current_user.current_plan %>
            I know your profile and <%= current_user.current_plan.title %>. Ask me anything about today's workout, your meals or your progress.
          <% else %>
            I know your profile. Once you create a plan, I can help you with it day by day.
          <% end %>
        </p>
        <div class="d-flex flex-column gap-2">
          <% ["What should I focus on today?", "Can I swap today's dinner?", "How do I stay motivated this week?"].each do |suggestion| %>
            <%= button_to suggestion, ask_coach_path, params: { content: suggestion },
                          class: "coach-suggestion", form: { data: { turbo_frame: "coach" } } %>
          <% end %>
        </div>
      </div>
    <% end %>

    <% @messages.each do |message| %>
      <div class="coach-message coach-message-<%= message.role %>">
        <%= raw(render_markdown(message.content)) %>
      </div>
    <% end %>

    <% if flash[:coach_error] %>
      <p class="coach-error"><%= flash[:coach_error] %></p>
    <% end %>
  </div>

  <div class="coach-footer">
    <div class="d-flex justify-content-between align-items-center mb-2 small">
      <span class="text-muted"><%= questions_left %> of <%= Chat::MAX_COACH_QUESTIONS %> questions left</span>
      <% if @messages.any? %>
        <%= button_to "New conversation", reset_coach_path, class: "btn btn-link btn-sm p-0 text-muted",
                      form: { data: { turbo_frame: "coach" } } %>
      <% end %>
    </div>

    <% if questions_left.positive? %>
      <%= form_with url: ask_coach_path, data: { turbo_frame: "coach", controller: "coach" }, class: "coach-form" do |f| %>
        <%= f.text_area :content, rows: 2, maxlength: Chat::MAX_QUESTION_LENGTH, required: true,
                        placeholder: "Ask your coach…", class: "form-control",
                        data: { action: "keydown->coach#submitOnEnter" } %>
        <%= f.button "Send", class: "btn btn-primary", data: { turbo_submits_with: "…" } %>
      <% end %>
    <% else %>
      <div class="coach-limit">
        <p class="mb-2">You've used all <%= Chat::MAX_COACH_QUESTIONS %> questions in this conversation.</p>
        <%= button_to "Start a new conversation", reset_coach_path, class: "btn btn-primary btn-sm",
                      form: { data: { turbo_frame: "coach" } } %>
      </div>
    <% end %>
  </div>
<% end %>
