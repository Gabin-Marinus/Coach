<%# Shown inside the coach panel (turbo frame "coach"). Links in answers open in the full page. %>
<%= turbo_frame_tag "coach", target: "_top", class: "coach-frame" do %>
  <%# Live updates: the coach's answer appears bit by bit (ChatResponseJob) %>
  <%= turbo_stream_from @chat, :messages if @chat %>

  <div id="coach_messages" class="coach-messages" data-controller="coach autoscroll" data-coach-target="messages">
    <% if @messages.empty? %>
      <div id="coach_intro" class="coach-intro">
        <p class="mb-2"><strong>Hi! 👋 I'm your coach.</strong></p>
        <p class="mb-3">
          <% if current_user.current_plan %>
            I know your profile and <%= current_user.current_plan.title %>. Ask me anything about today's workout, your meals or your progress.
          <% else %>
            I know your profile. Once you create a plan, I can help you with it day by day.
          <% end %>
        </p>
        <div class="d-flex flex-column gap-2">
          <% ["What should I focus on today?", "Can I swap today's dinner?",
              "What's in season near me right now?", "How can I eat well on my budget this week?"].each do |suggestion| %>
            <%= button_to suggestion, ask_coach_path, params: { content: suggestion },
                          class: "coach-suggestion", form: { data: { turbo_frame: "coach" } } %>
          <% end %>
        </div>
      </div>
    <% end %>

    <% @messages.each do |message| %>
      <%= render "messages/message", message: message %>
    <% end %>

    <% if flash[:coach_error] %>
      <p class="coach-error"><%= flash[:coach_error] %></p>
    <% end %>
  </div>

  <%= render "coach/footer", chat: @chat %>
<% end %>
