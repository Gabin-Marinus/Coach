<%# Right after asking: the question, a "typing" bubble, and the form locked until the answer is done %>
<%= turbo_stream.remove "coach_intro" %>
<%= turbo_stream.append "coach_messages" do %>
  <%= render "messages/message", message: @message %>
  <%= render "messages/pending", chat: @chat, question: @message %>
<% end %>
<%= turbo_stream.replace "coach_footer", partial: "coach/footer", locals: { chat: @chat, disabled: true } %>
