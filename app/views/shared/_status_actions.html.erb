<%# flex-nowrap + flex-shrink-0: the buttons always stay side by side, the text next to them wraps instead %>
<div class="d-flex align-items-center gap-1 flex-nowrap flex-shrink-0 justify-content-end">
  <% if record.status != "planned" %>
    <%= status_badge(record.status) %>
  <% end %>

  <% if record.date <= Date.today %>
    <% if record.status == "planned" %>
      <%= button_to "Done", polymorphic_path(record), method: :patch,
                    params: { status: "done" },
                    class: "btn btn-sm btn-primary",
                    form: { class: "d-inline" } %>
      <%= button_to "Skip", polymorphic_path(record), method: :patch,
                    params: { status: "skipped" },
                    class: "btn btn-sm btn-outline-secondary",
                    form: { class: "d-inline" } %>
    <% else %>
      <%= button_to "Undo", polymorphic_path(record), method: :patch,
                    params: { status: "planned" },
                    class: "btn btn-sm btn-link text-muted",
                    form: { class: "d-inline" } %>
    <% end %>
  <% end %>
</div>
