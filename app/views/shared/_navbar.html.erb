<nav class="navbar navbar-expand-md navbar-dark navbar-coach sticky-top">
  <%= link_to root_path, class: "navbar-brand" do %>
    <span class="navbar-logo"></span> Coach
  <% end %>

  <% if user_signed_in? %>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCoach"
            aria-controls="navbarCoach" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarCoach">
      <%# On phones these links are in the tab bar at the bottom (shared/_tabbar) %>
      <div class="navbar-nav me-auto ms-md-4 gap-1 d-none d-md-flex">
        <%= link_to "Today", root_path, class: "nav-link #{'active' if current_page?(root_path)}" %>
        <%= link_to "My plan", plan_profile_path,
                    class: "nav-link #{'active' if controller_name == 'profiles' && %w[plan workouts meals].include?(action_name) && params[:plan_id].blank?}" %>
        <%= link_to "All plans", plans_profile_path,
                    class: "nav-link #{'active' if controller_name == 'profiles' && (action_name == 'plans' || params[:plan_id].present?)}" %>
        <%= link_to "My profile", profile_path,
                    class: "nav-link #{'active' if controller_name == 'profiles' && %w[show edit update].include?(action_name)}" %>
      </div>

      <div class="d-flex flex-wrap align-items-center gap-2 mt-3 mt-md-0">
        <span class="navbar-email d-none d-lg-inline me-2"><%= current_user.email %></span>
        <%= button_to "New plan", chats_path, method: :post,
                      class: "btn btn-sm btn-neon", form: { class: "d-inline" } %>
        <%= link_to "Log out", destroy_user_session_path,
                    data: { turbo_method: :delete }, class: "btn btn-sm btn-ghost" %>
      </div>
    </div>
  <% else %>
    <div class="d-flex gap-2 ms-auto">
      <%= link_to "Log in", new_user_session_path, class: "btn btn-sm btn-ghost" %>
      <%= link_to "Sign up", new_user_registration_path, class: "btn btn-sm btn-neon" %>
    </div>
  <% end %>
</nav>
