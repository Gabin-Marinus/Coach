<nav class="navbar-coach">
  <%= link_to root_path, class: "navbar-coach-brand" do %>
    <span class="navbar-coach-logo">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12h4l3-7 4 14 3-7h4"></path></svg>
    </span>
    Coach
  <% end %>

  <div class="navbar-coach-links">
    <% if user_signed_in? %>
      <%= link_to "My plan", plan_profile_path, class: "navbar-coach-link" %>
      <%= button_to "New plan", chats_path, method: :post, class: "navbar-coach-btn", form: { class: "d-inline" } %>
      <span class="navbar-coach-email"><%= current_user.email %></span>
      <%= link_to "Logout", destroy_user_session_path, data: { turbo_method: :delete }, class: "navbar-coach-btn-outline" %>
      <%= link_to "My profile", profile_path, class: "navbar-coach-link" %>
    <% else %>
      <%= link_to "Login", new_user_session_path, class: "navbar-coach-btn" %>
    <% end %>
  </div>
</nav>
