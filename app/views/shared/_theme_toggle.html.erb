<%# Sun/moon button: both are rendered, and each design's stylesheet hides the one it doesn't need
    (components/_theme_toggle.scss), so it also works with "Same as my device" %>
<div class="d-inline-flex <%= local_assigns[:classes] %>">
  <%= button_to theme_profile_path, method: :patch, params: { theme: "dark" },
                class: "theme-toggle theme-toggle-to-dark", form: { class: "d-inline" },
                title: "Switch to the dark design", aria: { label: "Switch to the dark design" } do %>
    <%# Crescent moon (own SVG: clearer than the icon font at this size) %>
    <svg class="theme-toggle-icon" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  <% end %>
  <%= button_to theme_profile_path, method: :patch, params: { theme: "light" },
                class: "theme-toggle theme-toggle-to-light", form: { class: "d-inline" },
                title: "Switch to the light design", aria: { label: "Switch to the light design" } do %>
    <%# Sun with separate rays (Font Awesome's sun looked like a settings gear) %>
    <svg class="theme-toggle-icon" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/>
      <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
            fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    </svg>
  <% end %>
</div>
