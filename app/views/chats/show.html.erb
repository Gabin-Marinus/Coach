<div class="page">
  <%= link_to "← My plan", plan_profile_path, class: "back-link" %>

  <h1 id="chat_title" class="page-title mb-4"><%= @chat.title %></h1>

  <div id="messages" class="mb-4">
    <% if @messages.empty? %>
      <% goals = current_user.goals.map { |g| User::GOALS[g] }.compact %>
      <div class="text-muted">
        <% if goals.any? %>
          <p>
            Hi! I'm your Coach. Based on your goals (<strong><%= goals.join(", ") %></strong>),
            I'll build a 1-month training and nutrition plan for you. Just say <strong>"new plan"</strong>
            and I'll use your profile, or make it fit your life even better by telling me (optional):
          </p>
          <ul>
            <li><strong>Sessions you already do every week</strong> and on which days, e.g. "football on Tuesday, yoga on Saturday". I'll keep them in your plan.</li>
            <li><strong>Meals you like and usually cook</strong>, e.g. "pasta with tomato sauce, chili, porridge". I'll build your meals around them.</li>
            <li> <strong>Cooking preferences</strong>, e.g. batch cooking</li>
            <li>Anything else: busy days, budget, foods you're tired of…</li>
          </ul>
        <% else %>
          Hi! I'm your Coach. Before I can build your plan, please
          <%= link_to "complete your profile", edit_profile_path %> and choose your goals.
        <% end %>
      </div>
    <% end %>

    <% @messages.each do |message| %>
      <% next if message.content.blank? %>

      <% if message.role == "user" %>
        <div class="d-flex justify-content-end mb-2">
          <div class="chat-bubble-user px-3 pt-3 pb-1">
            <%= raw(render_markdown(message.content)) %>
          </div>
        </div>
      <% else %>
        <div class="d-flex justify-content-start mb-4">
          <div class="px-3 pt-3 pb-1">
            <%= raw(render_markdown(message.content)) %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>

  <% if @chat.plan_proposed? %>
    <div class="text-center my-3">
      <%= button_to "Save my plan", chat_plans_path(@chat),
                    class: "btn btn-success btn-lg",
                    data: {
                      turbo_confirm: "Save my plan? Your current plan will be archived.",
                      turbo_submits_with: "Creating your 1-month plan... this can take a minute or two ⏳"
                    } %>
    </div>
  <% end %>

  <div id="new_message_container">
    <%= simple_form_for [@chat, @message] do |f| %>
      <%= f.input :content, label: false,
                  placeholder: "Ask your coach...",
                  input_html: { rows: 3 } %>
      <%= f.button :submit, "Send", class: "btn btn-primary" %>
    <% end %>
  </div>
</div>
