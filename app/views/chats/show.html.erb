<div class="container py-4" style="max-width: 800px;">
  <%= link_to "← All chats", chats_path, class: "text-muted text-decoration-none" %>

  <h1 id="chat_title" class="h3 my-3"><%= @chat.title %></h1>

  <div id="messages" class="mb-4">
    <% if @messages.empty? %>
      <p class="text-muted">
        Hi! I'm your Coach. Tell me what you'd like to achieve, and we'll build your plan together.
      </p>
    <% end %>

    <% @messages.each do |message| %>
      <% next if message.content.blank? %>

      <% if message.role == "user" %>
        <div class="d-flex justify-content-end mb-2">
          <div class="bg-light px-3 pt-3 pb-1 rounded-4">
            <%= raw(render_markdown(message.content)) %>
          </div>
        </div>
      <% else %>
        <div class="d-flex justify-content-start mb-4">
          <div class="px-3 pt-3 pb-1">
            <%= raw(render_markdown(message.content)) %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>

  <% if @chat.plan_proposed? %>
    <div class="text-center my-3">
      <%= button_to "Save my plan", chat_plans_path(@chat),
                    class: "btn btn-success",
                    data: { turbo_confirm: "Save my plan? Your current plan will be archived." } %>
    </div>
  <% end %>

  <div id="new_message_container">
    <%= simple_form_for [@chat, @message] do |f| %>
      <%= f.input :content, label: false,
                  placeholder: "Ask your coach...",
                  input_html: { rows: 3 } %>
      <%= f.button :submit, "Send", class: "btn btn-primary" %>
    <% end %>
  </div>
</div>
