<section class="widget home-empty" aria-label="Get started">
  <div class="widget-title">
    <div class="widget-icon widget-icon-green">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12h4l3-7 4 14 3-7h4"></path></svg>
    </div>
    <span class="widget-label">GET STARTED</span>
  </div>

  <% if user.ready_for_plan? %>
    <h2 class="home-empty-title">You don't have an active plan yet</h2>
    <p class="home-empty-text">Chat with your coach and they'll build your meals and workouts for the next 3 months.</p>
    <%= button_to "Create my plan", chats_path, method: :post, class: "btn-coach btn-coach-dark", form: { class: "home-empty-action" } %>
  <% else %>
    <h2 class="home-empty-title">Finish your profile first</h2>
    <p class="home-empty-text">Your coach needs your goals, body stats and training preferences to build your plan.</p>
    <div class="home-empty-action">
      <%= link_to "Complete my profile", edit_profile_path, class: "btn-coach btn-coach-dark" %>
    </div>
  <% end %>
</section>
