<% current = user.current_weight_kg %>
<% target = user.target_weight_kg %>

<section class="dash-goal">
  <%# Decorative neon swoosh on the right, behind the text (hidden under 1024px) %>
  <div class="dash-goal-swoosh" aria-hidden="true">
    <svg viewBox="0 0 320 220" preserveAspectRatio="xMaxYMid slice" aria-hidden="true">
      <path d="M10 230 C 120 215, 190 120, 330 20" fill="none" stroke="#C6F432" stroke-width="16" stroke-linecap="round" opacity="0.9"/>
      <path d="M60 240 C 150 222, 215 150, 330 78" fill="none" stroke="#F59E0B" stroke-width="7" stroke-linecap="round" opacity="0.9"/>
      <path d="M-10 200 C 100 192, 160 95, 330 -10" fill="none" stroke="#C6F432" stroke-width="2.5" stroke-linecap="round" opacity="0.55"/>
      <path d="M110 240 C 185 228, 240 182, 330 132" fill="none" stroke="#C6F432" stroke-width="1.5" stroke-linecap="round" opacity="0.35"/>
      <path d="M150 240 C 215 232, 265 205, 330 172" fill="none" stroke="#F59E0B" stroke-width="1.2" stroke-linecap="round" opacity="0.35"/>
    </svg>
  </div>

  <% if plan %>
    <p class="dash-goal-plan"><strong><%= plan.title %></strong> · <%= plan.timeframe %></p>
  <% end %>

  <div class="dash-goal-weights">
    <div>
      <p class="dash-goal-label">Current</p>
      <p class="dash-goal-value"><%= current ? number_with_precision(current, precision: 1, strip_insignificant_zeros: true) : "–" %><small>kg</small></p>
    </div>
    <span class="dash-goal-arrow">→</span>
    <div>
      <p class="dash-goal-label">Goal</p>
      <p class="dash-goal-value text-accent"><%= target ? number_with_precision(target, precision: 1, strip_insignificant_zeros: true) : "–" %><small>kg</small></p>
    </div>
  </div>

  <% if current && target && current != target %>
    <p class="dash-goal-togo">
      <%= number_with_precision((current - target).abs, precision: 1, strip_insignificant_zeros: true) %> kg
      to <%= current > target ? "lose" : "gain" %>
    </p>
  <% end %>

  <% if user.goals.any? %>
    <div class="dash-goal-pills">
      <% user.goals.each do |goal| %>
        <span class="dash-pill"><%= User::GOALS[goal] %></span>
      <% end %>
    </div>
  <% end %>

  <% if plan %>
    <% total_days = (plan.end_date - plan.start_date).to_i + 1 %>
    <% days_in = (Date.today - plan.start_date).to_i.clamp(0, total_days) %>
    <div class="dash-goal-progress">
      <div class="d-flex justify-content-between">
        <span>Week <%= plan.current_week %> of <%= plan.total_weeks %></span>
        <span><%= (plan.end_date - Date.today).to_i.clamp(0, total_days) %> days left</span>
      </div>
      <div class="dash-progress"><div style="width: <%= (100.0 * days_in / total_days).round %>%"></div></div>
    </div>
  <% end %>
</section>
