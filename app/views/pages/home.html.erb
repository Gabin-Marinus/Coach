<% content_for :with_sidebar, "true" %>

<header class="home-header">
  <div>
    <p class="home-date"><%= Date.today.strftime("%A, %-d %B") %></p>
    <h1 class="home-title"><%= greeting %>, <%= display_name(current_user) %></h1>
  </div>
  <div class="home-actions">
    <% if @plan %>
      <%= link_to plan_profile_path, class: "btn-coach btn-coach-outline" do %>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="17" rx="2"></rect><path d="M16 2v4M8 2v4M3 10h18"></path></svg>
        See full plan
      <% end %>
    <% end %>
    <%= link_to chats_path, class: "btn-coach btn-coach-dark" do %>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20.5l1.4-4.9A8 8 0 1 1 21 12z"></path></svg>
      Ask your coach
    <% end %>
  </div>
</header>

<% if @plan.nil? %>
  <%= render "pages/no_plan", user: current_user %>
<% else %>
  <%= render "pages/weight_goal", user: current_user, plan: @plan %>

  <%= render "pages/todays_meals", meals: @todays_meals %>

  <div class="home-row">
    <%= render "pages/nutrition", meals: @todays_meals %>
    <%= render "pages/todays_workout", workout: @todays_workout, plan: @plan, user: current_user %>
  </div>
<% end %>
