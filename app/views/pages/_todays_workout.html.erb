<% day_label = "#{Date.today.strftime('%A').upcase} · WEEK #{plan.current_week}" %>
<% dumbbell = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6.5 6.5v11"></path><path d="M17.5 6.5v11"></path><path d="M3.5 9v6"></path><path d="M20.5 9v6"></path><path d="M6.5 12h11"></path></svg>'.html_safe %>

<% if workout.nil? %>
  <section class="widget" aria-label="Today's workout">
    <div class="widget-header">
      <div class="widget-title">
        <div class="widget-icon widget-icon-green"><%= dumbbell %></div>
        <span class="widget-label">TODAY'S WORKOUT</span>
      </div>
      <span class="status-tag">Rest day</span>
    </div>

    <div class="workout-hero">
      <div class="workout-title">
        <span class="workout-day"><%= day_label %></span>
        <span class="workout-name">Rest &amp; recover</span>
      </div>
      <p class="workout-description">No training planned today. Sleep well, stay hydrated and get some light movement in.</p>
    </div>

    <%= link_to "See this week's workouts", workouts_profile_path, class: "workout-footer workout-footer-link" %>
  </section>
<% else %>
  <div class="flip-card" data-controller="flip-card">
    <div class="flip-card-inner">

      <%# FRONT: today's workout %>
      <section class="widget flip-card-face flip-card-front" aria-label="Today's workout">
        <div class="widget-header">
          <div class="widget-title">
            <div class="widget-icon widget-icon-green"><%= dumbbell %></div>
            <span class="widget-label">TODAY'S WORKOUT</span>
          </div>
          <span class="status-tag"><%= workout_status_label(workout) %></span>
        </div>

        <div class="workout-hero">
          <div class="workout-hero-top">
            <div class="workout-title">
              <span class="workout-day"><%= day_label %></span>
              <span class="workout-name"><%= workout.name %></span>
            </div>
            <div class="workout-stats">
              <div class="workout-stat">
                <span class="workout-stat-value"><%= workout.duration_min || "–" %><span class="workout-stat-unit"> min</span></span>
                <span class="workout-stat-label">Duration</span>
              </div>
              <div class="workout-stat">
                <span class="workout-stat-value"><%= user.training_location&.humanize || "–" %></span>
                <span class="workout-stat-label">Location</span>
              </div>
            </div>
          </div>
        </div>

        <button type="button" class="workout-footer" data-action="click->flip-card#flip">
          See workout details
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
        </button>
      </section>

      <%# BACK: details + log it %>
      <section class="widget flip-card-face flip-card-back" aria-label="Workout details">
        <div class="widget-header">
          <div class="widget-title">
            <div class="widget-icon widget-icon-green"><%= dumbbell %></div>
            <span class="widget-label"><%= workout.name.upcase %></span>
          </div>
          <button type="button" class="flip-back-button" data-action="click->flip-card#flip">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg>
            Back
          </button>
        </div>

        <p class="workout-description"><%= workout.description.presence || "Your coach didn't add details for this session." %></p>

        <div class="workout-actions">
          <% if workout.status == "planned" %>
            <%= button_to "Mark as done", workout_path(workout), method: :patch, params: { status: "done" }, class: "btn-coach btn-coach-dark" %>
            <%= button_to "Skip", workout_path(workout), method: :patch, params: { status: "skipped" }, class: "btn-coach btn-coach-outline" %>
          <% else %>
            <%= button_to "Undo", workout_path(workout), method: :patch, params: { status: "planned" }, class: "btn-coach btn-coach-outline" %>
          <% end %>
          <%= link_to "This week's workouts →", workouts_profile_path, class: "widget-link widget-link-pill" %>
        </div>
      </section>

    </div>
  </div>
<% end %>
