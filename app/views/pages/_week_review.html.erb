<% icons = {
  good: '<path d="M5 12.5l4.5 4.5L19 7.5"></path>',
  low: '<path d="M12 8v5M12 16.5v.5"></path>',
  high: '<path d="M12 8v5M12 16.5v.5"></path>'
} %>

<section class="widget" aria-label="Weekly review">
  <div class="widget-title">
    <div class="widget-icon widget-icon-green">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 11l3 3 8-8"></path><path d="M20 12v7a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h9"></path></svg>
    </div>
    <span class="widget-label">WEEKLY REVIEW</span>
  </div>

  <div class="review-grid">
    <% summary.review.each do |item| %>
      <div class="review-item">
        <span class="review-icon review-icon-<%= item[:tone] %>"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%= icons[item[:tone]].html_safe %></svg></span>
        <div class="review-text">
          <span class="review-title"><%= item[:title] %></span>
          <span class="review-body"><%= item[:body] %></span>
        </div>
      </div>
    <% end %>
  </div>
</section>
