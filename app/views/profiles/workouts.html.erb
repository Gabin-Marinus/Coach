<div class="page">
  <%= link_to "← My plan", plan_profile_path(plan_params(@week)), class: "back-link" %>

  <% if @plan.nil? %>
    <div class="page-header"><h1 class="page-title">My workouts</h1></div>
    <%= render "no_plan" %>
  <% else %>
    <%= render "plan_header", plan: @plan, week: @week, section: "Workouts" %>
    <%= render "week_navigation", plan: @plan, week: @week %>

    <div class="card overflow-hidden">
      <table class="table align-middle mb-0">
        <thead>
          <tr>
            <th>Date</th>
            <th>Workout</th>
            <%# d-none d-md-table-cell: hidden on phones, shown from tablets up %>
            <th class="d-none d-md-table-cell">Duration</th>
            <th class="text-end">Status</th>
          </tr>
        </thead>
        <tbody>
          <% @dates.each do |date| %>
            <% day_workouts = @workouts_by_date[date] || [] %>

            <% if day_workouts.empty? %>
              <tr class="text-muted <%= 'table-today' if date == Date.today %>">
                <td class="text-nowrap"><%= date.strftime("%a, %b %-d") %></td>
                <td colspan="3">Rest day</td>
              </tr>
            <% else %>
              <% day_workouts.each do |workout| %>
                <tr class="<%= 'table-today' if date == Date.today %>">
                  <td class="text-nowrap"><%= date.strftime("%a, %b %-d") %></td>
                  <td>
                    <strong><%= workout.name %></strong>
                    <%# On phones the duration is shown here, next to the name %>
                    <% if workout.duration_min %>
                      <span class="small d-md-none">· <%= workout.duration_min %> min</span>
                    <% end %>
                    <div class="small text-muted"><%= workout.description %></div>
                  </td>
                  <td class="text-nowrap d-none d-md-table-cell"><%= workout.duration_min ? "#{workout.duration_min} min" : "–" %></td>
                  <td><%= render "shared/status_actions", record: workout %></td>
                </tr>
              <% end %>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
