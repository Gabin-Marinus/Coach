<div class="container py-4" style="max-width: 900px;">
  <%= link_to "← My profile", profile_path, class: "text-muted text-decoration-none" %>
  <h1 class="h3 my-3">My workout plan</h1>

  <% if @plan.nil? %>
    <p class="text-muted">You don't have a plan yet. Chat with your coach to create one.</p>
    <%= button_to "New chat", chats_path, class: "btn btn-primary" %>
  <% else %>
    <p class="text-muted mb-0">
      <%= @plan.goal_labels.join(", ") %> ·
      <%= @plan.start_date.strftime("%b %-d, %Y") %> – <%= @plan.end_date.strftime("%b %-d, %Y") %>
    </p>

    <%= render "week_navigation", plan: @plan, week: @week %>

    <table class="table align-middle">
      <thead>
        <tr>
          <th>Date</th>
          <th>Workout</th>
          <th>Duration</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% @dates.each do |date| %>
          <% day_workouts = @workouts_by_date[date] || [] %>

          <% if day_workouts.empty? %>
            <tr class="text-muted <%= 'table-primary' if date == Date.today %>">
              <td><%= date.strftime("%a, %b %-d") %></td>
              <td colspan="3">Rest day</td>
            </tr>
          <% else %>
            <% day_workouts.each do |workout| %>
              <tr class="<%= 'table-primary' if date == Date.today %>">
                <td><%= date.strftime("%a, %b %-d") %></td>
                <td>
                  <strong><%= workout.name %></strong>
                  <div class="small text-muted"><%= workout.description %></div>
                </td>
                <td><%= workout.duration_min ? "#{workout.duration_min} min" : "–" %></td>
                  <td><%= render "shared/status_actions", record: workout %></td>
              </tr>
            <% end %>
          <% end %>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
