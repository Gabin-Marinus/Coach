<div class="page">
  <% if params[:plan_id].present? %>
    <%= link_to "← All plans", plans_profile_path, class: "back-link" %>
  <% end %>
  <% if @plan.nil? %>
    <div class="page-header"><h1 class="page-title">My plan</h1></div>
    <%= render "no_plan" %>
  <% else %>
    <%= render "plan_header", plan: @plan, week: @week, section: nil %>
    <%= render "week_navigation", plan: @plan, week: @week %>

    <% @dates.each do |date| %>
      <% day_workouts = @workouts_by_date[date] || [] %>
      <% day_meals = (@meals_by_date[date] || []).sort_by { |m| Meal::MEAL_TYPES.keys.index(m.meal_type) || 99 } %>

      <div class="card mb-3 <%= 'card-today' if date == Date.today %>">
        <div class="card-header d-flex flex-wrap justify-content-between gap-2">
          <strong><%= date.strftime("%A, %b %-d") %><%= " · Today" if date == Date.today %></strong>
          <span class="text-muted small">
            <%= day_meals.sum { |m| m.calories.to_i } %> kcal ·
            P <%= day_meals.sum { |m| m.protein_g.to_i } %> g ·
            C <%= day_meals.sum { |m| m.carbs_g.to_i } %> g ·
            F <%= day_meals.sum { |m| m.fat_g.to_i } %> g
          </span>
        </div>

        <div class="card-body">
          <h2 class="section-title mt-0">Workout</h2>
          <% if day_workouts.empty? %>
            <p class="text-muted">Rest day</p>
          <% else %>
            <% day_workouts.each do |workout| %>
              <div class="d-flex justify-content-between align-items-start gap-3 mb-2">
                <div>
                  <strong><%= workout.name %></strong>
                  <% if workout.duration_min %> · <%= workout.duration_min %> min<% end %>
                  <div class="small text-muted"><%= workout.description %></div>
                </div>
                <%= render "shared/status_actions", record: workout %>
              </div>
            <% end %>
          <% end %>

          <h2 class="section-title">Meals</h2>
          <% day_meals.each do |meal| %>
            <div class="d-flex justify-content-between align-items-start gap-3 mb-2">
              <div>
                <span class="text-muted"><%= Meal::MEAL_TYPES[meal.meal_type] %>:</span>
                <strong><%= meal.name %></strong>
                <span class="small text-muted">· <%= meal.calories %> kcal</span>
                <% if meal.recipe.present? %>
                  <details class="small">
                    <summary>Recipe</summary>
                    <%= meal.recipe %>
                  </details>
                <% end %>
              </div>
              <%= render "shared/status_actions", record: meal %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
