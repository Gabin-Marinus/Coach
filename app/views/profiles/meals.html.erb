<div class="page">
  <%= link_to "← My plan", plan_profile_path(plan_params(@week)), class: "back-link" %>

  <% if @plan.nil? %>
    <div class="page-header"><h1 class="page-title">My meals</h1></div>
    <%= render "no_plan" %>
  <% else %>
    <%= render "plan_header", plan: @plan, week: @week, section: "Meals" %>
    <%= render "week_navigation", plan: @plan, week: @week %>

    <% @dates.each do |date| %>
      <% day_meals = (@meals_by_date[date] || []).sort_by { |meal| Meal::MEAL_TYPES.keys.index(meal.meal_type) || 99 } %>

      <div class="card mb-3 overflow-hidden <%= 'card-today' if date == Date.today %>">
        <div class="card-header d-flex flex-wrap justify-content-between gap-2">
          <strong><%= date.strftime("%A, %b %-d") %><%= " · Today" if date == Date.today %></strong>
          <span class="text-muted small">
            <%= day_meals.sum { |meal| meal.calories.to_i } %> kcal ·
            P <%= day_meals.sum { |meal| meal.protein_g.to_i } %> g ·
            C <%= day_meals.sum { |meal| meal.carbs_g.to_i } %> g ·
            F <%= day_meals.sum { |meal| meal.fat_g.to_i } %> g
          </span>
        </div>

        <div class="table-responsive">
          <table class="table align-middle mb-0">
            <thead>
              <tr>
                <th>Meal</th>
                <th>Dish</th>
                <th>kcal</th>
                <th>Protein</th>
                <th>Carbs</th>
                <th>Fat</th>
                <th class="text-end">Status</th>
              </tr>
            </thead>
            <tbody>
              <% day_meals.each do |meal| %>
                <tr>
                  <td><%= Meal::MEAL_TYPES[meal.meal_type] %></td>
                  <td>
                    <strong><%= meal.name %></strong>
                    <div class="small text-muted"><%= meal.description %></div>
                    <% if meal.recipe.present? %>
                      <details class="small">
                        <summary>Recipe</summary>
                        <%= meal.recipe %>
                      </details>
                    <% end %>
                  </td>
                  <td><%= meal.calories %></td>
                  <td class="text-nowrap"><%= meal.protein_g %> g</td>
                  <td class="text-nowrap"><%= meal.carbs_g %> g</td>
                  <td class="text-nowrap"><%= meal.fat_g %> g</td>
                  <td><%= render "shared/status_actions", record: meal %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
