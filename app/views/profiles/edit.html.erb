<div class="page">
  <%= link_to "← My profile", profile_path, class: "back-link" %>
  <div class="page-header">
    <div>
      <h1 class="page-title">Tell us about you</h1>
      <p class="page-subtitle">We use this to build your meal and training plan.</p>
    </div>
  </div>

  <%= simple_form_for @user, url: profile_path, method: :patch do |f| %>
    <%= f.error_notification %>

    <%# ---------- 1. About you ---------- %>
    <h2 class="section-title mt-5">1. About you</h2>

    <%= f.input :birth_date, as: :date, html5: true, required: true %>

    <%= f.input :sex,
                label: "Sex (used to calculate your calorie needs)",
                prompt: "Choose one",
                collection: User::SEXES.invert,
                required: true %>

    <div class="row">
      <div class="col-md-6">
        <%= f.input :height_cm, label: "Height (cm)", required: true,
                    input_html: { min: 100, max: 250 } %>
      </div>
      <div class="col-md-6">
        <%= f.input :current_weight_kg, label: "Current weight (kg)", required: true,
                    input_html: { min: 30, max: 300, step: 0.1 } %>
      </div>
    </div>

    <%= f.input :activity_level,
                label: "How active are you outside of workouts?",
                prompt: "Choose one",
                collection: User::ACTIVITY_LEVELS.invert,
                required: true %>

    <p class="form-text mb-2">Where do you live? Your coach uses it to suggest local food that is in season.</p>
    <div class="row">
      <div class="col-md-6">
        <%= f.input :city, label: "City (optional)",
                    input_html: { placeholder: "e.g. Lyon", autocomplete: "address-level2" } %>
      </div>
      <div class="col-md-6">
        <%= f.input :country, label: "Country", required: true,
                    collection: User::COUNTRIES,
                    prompt: "Choose one",
                    input_html: { autocomplete: "country-name" } %>
      </div>
    </div>

    <%# ---------- 2. Goal ---------- %>
    <h2 class="section-title mt-5">2. Your goal</h2>

    <%= f.input :goals, label: "What are your goals?",
                as: :check_boxes,
                collection: User::GOALS.invert,
                required: true %>

    <%= f.input :target_weight_kg, label: "Target weight (kg, optional)",
                input_html: { min: 30, max: 300, step: 0.1 } %>

    <%# ---------- 3. Food ---------- %>
    <h2 class="section-title mt-5">3. Food</h2>

    <%= f.input :diet_type, label: "Diet",
                collection: User::DIET_TYPES.invert,
                prompt: "Choose one", required: true %>

    <%= f.input :allergies, label: "Allergies or intolerances",
                as: :check_boxes,
                collection: User::ALLERGIES.invert %>

    <%= f.input :food_dislikes, label: "Anything you don't eat or don't like?",
                input_html: { rows: 2, placeholder: "e.g. mushrooms, very spicy food" } %>

    <%= f.input :favorite_meals, label: "Favourite meals (optional)",
                hint: "Dishes you love or often cook. Your coach adds them to your plan once or twice a week.",
                input_html: { rows: 2, maxlength: 500, placeholder: "e.g. spaghetti bolognese, chicken curry, pancakes" } %>

    <div class="row">
      <div class="col-md-6">
        <%= f.input :meals_per_day, label: "Meals per day",
                    collection: User::MEALS_PER_DAY,
                    prompt: "Choose one", required: true %>
      </div>
    </div>

    <%= f.input :cooking_time, label: "How much time do you want to spend cooking?",
                prompt: "Choose one",
                collection: User::COOKING_TIMES.invert,
                required: true %>

    <%# Food budget: the meal plan is built to fit in it %>
    <div data-controller="budget">
      <p class="fw-semibold mb-1">How much do you want to spend on food? <abbr title="required">*</abbr></p>
      <p class="form-text mt-0 mb-2">Your groceries for all your meals. Pick a suggestion or type your own amount.</p>

      <div class="d-flex flex-wrap gap-2 mb-3">
        <% [30, 50, 75, 100, 150].each do |amount| %>
          <button type="button" class="budget-chip" data-action="budget#pick"
                  data-budget-amount-param="<%= amount %>" data-budget-period-param="week">
            <%= amount %> / week
          </button>
        <% end %>
      </div>

      <div class="row">
        <div class="col-md-4">
          <%= f.input :food_budget, label: "Amount", required: true,
                      input_html: { min: 1, step: 1, data: { budget_target: "amount" } } %>
        </div>
        <div class="col-md-4">
          <%= f.input :currency, label: "Currency", required: true,
                      collection: User::CURRENCIES.invert,
                      prompt: "Choose one" %>
        </div>
        <div class="col-md-4">
          <%= f.input :food_budget_period, label: "Period", required: true,
                      collection: User::BUDGET_PERIODS.invert,
                      selected: f.object.food_budget_period || "week",
                      input_html: { data: { budget_target: "period" } } %>
        </div>
      </div>
    </div>

    <%# ---------- 4. Training ---------- %>
    <h2 class="section-title mt-5">4. Training</h2>

    <%= f.input :fitness_level, label: "Your fitness level",
                prompt: "Choose one",
                collection: User::FITNESS_LEVELS.invert,
                required: true %>

    <%= f.input :exercise_types, label: "What do you enjoy?",
                as: :check_boxes,
                collection: User::EXERCISE_TYPES.invert %>

    <div data-controller="equipment">
      <%= f.input :training_location, label: "Where do you train?",
                  prompt: "Choose one",
                  collection: User::TRAINING_LOCATIONS.invert,
                  required: true,
                  input_html: { data: { action: "change->equipment#toggle" } } %>

      <%# Not asked for gym training, gym users get all equipment (see User#set_equipment_from_location) %>
      <div data-equipment-target="equipment">
        <%= f.input :equipment, label: "What equipment do you have access to?",
                    as: :check_boxes,
                    collection: User::EQUIPMENT.invert %>
      </div>
    </div>

    <div class="row">
      <div class="col-md-6">
        <%= f.input :training_days_per_week, label: "Days per week",
                    collection: User::TRAINING_DAYS,
                    prompt: "Choose one", required: true %>
      </div>
      <div class="col-md-6">
        <%= f.input :session_minutes, label: "Minutes per session",
                    collection: User::SESSION_MINUTES.map { |m| ["#{m} min", m] },
                    prompt: "Choose one", required: true %>
      </div>
    </div>

    <%= f.input :preferred_time, label: "When do you prefer to train? (optional)",
                collection: User::PREFERRED_TIMES.invert,
                include_blank: "No preference" %>

    <%= f.input :injuries, label: "Any injuries or problem areas?",
                as: :check_boxes,
                collection: User::INJURIES.invert %>

    <%= f.input :injury_notes, label: "Anything we should know about them?",
                input_html: { rows: 2, placeholder: "e.g. knee pain when running downhill" } %>

    <%= f.input :exercise_dislikes, label: "Exercises you don't like (optional)",
                input_html: { rows: 2, placeholder: "e.g. burpees, running" } %>

    <%= f.button :submit, "Save my profile", class: "btn btn-primary btn-lg mt-4 w-100" %>
  <% end %>
</div>
