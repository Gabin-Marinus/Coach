<%# Title of the plan pages: "Plan #1", its dates, goals and the All / Workouts / Meals switch %>
<div class="page-header">
  <div>
    <p class="page-eyebrow">
      <%= plan.timeframe %><%= " · Week #{plan.current_week} of #{plan.total_weeks}" unless plan.ended? %>
    </p>
    <h1 class="page-title">
      <%= plan.title %><%= " · #{section}" if section %>
      <%= plan_status_badge(plan) unless plan.status == "active" && !plan.ended? %>
    </h1>
    <p class="page-subtitle"><%= plan.goal_labels.join(" · ") %></p>
  </div>

  <div class="d-flex flex-wrap gap-2">
    <div class="btn-group btn-group-sm" role="group" aria-label="Plan view">
      <%= link_to "All", plan_profile_path(plan_params(week)),
                  class: "btn #{section.nil? ? 'btn-primary' : 'btn-outline-secondary'}" %>
      <%= link_to "Workouts", workouts_profile_path(plan_params(week)),
                  class: "btn #{section == 'Workouts' ? 'btn-primary' : 'btn-outline-secondary'}" %>
      <%= link_to "Meals", meals_profile_path(plan_params(week)),
                  class: "btn #{section == 'Meals' ? 'btn-primary' : 'btn-outline-secondary'}" %>
    </div>

    <button type="button" class="btn btn-sm btn-neon" data-bs-toggle="modal" data-bs-target="#calendarModal">
      <i class="fa-regular fa-calendar-plus me-1"></i> Add to calendar
    </button>
  </div>
</div>

<%# "Add to calendar" modal: download the .ics file, then import it in Google Calendar %>
<div class="modal fade" id="calendarModal" tabindex="-1" aria-labelledby="calendarModalTitle" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h2 class="modal-title h5 fw-bold" id="calendarModalTitle">Add <%= plan.title %> to your calendar</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <ol class="calendar-steps">
          <li>
            <strong>Download your plan</strong>
            <div class="mt-2">
              <%= link_to calendar_plan_path(plan, format: :ics), class: "btn btn-primary", data: { turbo: false } do %>
                <i class="fa-solid fa-download me-1"></i> Download calendar file
              <% end %>
            </div>
          </li>
          <li>
            <strong>Open Google Calendar import</strong>
            <div class="mt-2">
              <%= link_to "https://calendar.google.com/calendar/r/settings/export",
                          target: "_blank", rel: "noopener", class: "btn btn-outline-secondary" do %>
                Open Google Calendar <i class="fa-solid fa-arrow-up-right-from-square ms-1"></i>
              <% end %>
            </div>
          </li>
          <li>
            <strong>Choose the file and click "Import"</strong>
          </li>
        </ol>

        <p class="small text-muted mb-0">
          Workouts and meals are added as all-day events marked <strong>Free</strong>, so they never block your time.
          Tip: create a calendar called "Coach" in Google Calendar first and import into it,
          so you can hide or remove the whole plan at once.
          On iPhone or Outlook, just open the file.
        </p>
      </div>
    </div>
  </div>
</div>

<%# What the AI based the plan on (calories, protein, training...) %>
<% if plan.summary.present? %>
  <details class="plan-why" <%= "open" if section.nil? %>>
    <summary><span class="plan-why-icon">i</span> Why this plan</summary>
    <div class="plan-why-body"><%= raw(render_markdown(plan.summary)) %></div>
  </details>
<% else %>
  <div class="plan-why plan-why-empty">
    <span><span class="plan-why-icon">i</span> See what your coach based this plan on</span>
    <%= button_to "Explain this plan", summary_plan_path(plan), class: "btn btn-sm btn-neon",
                  data: { turbo_submits_with: "Thinking… ⏳" } %>
  </div>
<% end %>
