<div class="auth">
  <div class="auth-card">
    <span class="auth-badge">Your AI fitness coach</span>
    <h1 class="auth-title">Create your account</h1>
    <p class="auth-subtitle">Get a personal 3-month training and meal plan.</p>

    <%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <%= f.input :email, required: true, autofocus: true,
                  input_html: { autocomplete: "email" } %>
      <%= f.input :password, required: true,
                  hint: ("At least #{@minimum_password_length} characters" if @minimum_password_length),
                  input_html: { autocomplete: "new-password" } %>
      <%= f.input :password_confirmation, label: "Confirm password", required: true,
                  input_html: { autocomplete: "new-password" } %>

      <%= f.button :submit, "Sign up", class: "btn btn-primary w-100 mt-2" %>
    <% end %>

    <div class="auth-links">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
